pragma solidity ^0.8.36;

import { Vm } from "forge-std/Vm.sol";
import { LibBLS12381 as BLS } from "commonware/certificate/LibBLS12381.sol";
import { BajillionSettlement } from "../../src/BajillionSettlement.sol";

/// @notice Loads the crate fixtures in test/fixtures/ (generated by offchain/fixtures from
/// commonware-clearing at dd6d60cb). Each *.hex file is one 0x-prefixed string; manifest.json
/// carries the scenario parameters and the EIP-2537 encodings of every BLS point.
library Fixture {
    Vm internal constant vm = Vm(address(uint160(uint256(keccak256("hevm cheat code")))));
    string internal constant DIR = "test/fixtures/";

    function hexFile(string memory name) internal view returns (bytes memory) {
        return vm.parseBytes(vm.readFile(string.concat(DIR, name, ".hex")));
    }

    function manifest() internal view returns (string memory) {
        return vm.readFile(string.concat(DIR, "manifest.json"));
    }

    function bytesAt(string memory key) internal view returns (bytes memory) {
        return vm.parseJsonBytes(manifest(), key);
    }

    function bytes32At(string memory key) internal view returns (bytes32) {
        return vm.parseJsonBytes32(manifest(), key);
    }

    function uintAt(string memory key) internal view returns (uint256) {
        return vm.parseJsonUint(manifest(), key);
    }

    /// @dev EIP-2537 G2 (256 bytes, `x.c0 || x.c1 || y.c0 || y.c1`, each padded to 64).
    function g2(string memory key) internal view returns (BLS.G2Point memory) {
        return abi.decode(bytesAt(key), (BLS.G2Point));
    }

    /// @dev EIP-2537 G1 (128 bytes, padded) to the unpadded 96-byte `x || y` hint the contract takes.
    function g1Hint(string memory key) internal view returns (bytes memory) {
        bytes memory p = bytesAt(key);
        require(p.length == 128, "g1 length");
        bytes memory out = new bytes(96);
        for (uint256 i; i < 48; ++i) {
            out[i] = p[16 + i];
            out[48 + i] = p[80 + i];
        }
        return out;
    }

    function committeePoints() internal view returns (BLS.G2Point[] memory points) {
        points = new BLS.G2Point[](4);
        for (uint256 i; i < 4; ++i) {
            points[i] = g2(_member(i, "public_key.eip2537"));
        }
    }

    function deploymentArgs(address asset, uint256 bond)
        internal
        view
        returns (BajillionSettlement.DeploymentArgs memory d)
    {
        d.deployment = bytes32At(".scenario.deployment");
        d.operator = bytes32At(".scenario.operator");
        d.expectedEpoch = uint64(uintAt(".scenario.epoch"));
        d.genesis = BajillionSettlement.Genesis(
            bytes32(hexFile("genesis_state_root")),
            uint64(uintAt(".scenario.genesis.operations")),
            uint64(uintAt(".scenario.genesis.liability"))
        );
        d.config = BajillionSettlement.SettlementConfig(
            uint64(uintAt(".scenario.settlement_config.admission_delay")),
            uint64(uintAt(".scenario.settlement_config.challenge_duration")),
            uint64(uintAt(".scenario.settlement_config.deposit_inclusion_timeout")),
            uint64(uintAt(".scenario.settlement_config.minimum_withdrawal_notice")),
            uint64(uintAt(".scenario.settlement_config.maximum_withdrawal_notice")),
            uint64(uintAt(".scenario.settlement_config.max_destination_bytes")),
            uint64(uintAt(".scenario.settlement_config.max_deposit_ids"))
        );
        d.asset = asset;
        d.bond = bond;
        d.popNamespace = bytesAt(".bls.pop_namespace");
        d.maxChallengeBytes = uint64(uintAt(".scenario.settlement_config.max_challenge_bytes"));
        d.committee = new BajillionSettlement.Validator[](4);
        for (uint256 i; i < 4; ++i) {
            d.committee[i] = BajillionSettlement.Validator(
                bytesAt(_member(i, "public_key.compressed")),
                g2(_member(i, "public_key.eip2537")),
                bytesAt(_member(i, "proof_of_possession.compressed")),
                g1Hint(_member(i, "proof_of_possession.eip2537"))
            );
        }
    }

    /// @dev The fixture admission, exactly as the crate produced it.
    function admission() internal view returns (BajillionSettlement.Admission memory a) {
        a.header = bytes32(hexFile("header"));
        a.roots = hexFile("root_bundle");
        a.withdrawalTotal = uint64(uintAt(".close.withdrawal_total"));
        a.certificate = hexFile("certificate");
        a.signature = g1Hint(".bls.certificate.aggregate_signature.eip2537");
        a.committee = committeePoints();
        a.deposits = hexFile("deposit_batch");
        a.withdrawals = hexFile("withdrawal_batch");
    }

    function _member(uint256 i, string memory field) private pure returns (string memory) {
        return string.concat(".bls.committee[", vm.toString(i), "].", field);
    }
}
